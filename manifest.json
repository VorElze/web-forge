  "excluded": {
    "reason": "Skill non-perangkat-lunak tidak pernah dipaksa; memaksanya menghasilkan slop.",
    "examples": ["apple-notes", "findmy", "songsee", "arxiv", "roblox-video-render", "absensi-report"]
  },
  "gates": {
    "brief": "docs/BRIEF.md punya 8 jawaban + satu acuan",
    "spec": "docs/SPEC.md punya sasaran, non-sasaran, kriteria selesai, tanpa TBD",
    "plan": "docs/PLAN.md punya >=3 task, semuanya berbaris Gate:",
    "encoding": "tidak ada BOM, tidak ada mojibake",
    "secrets": ".env tidak ter-track, tidak ada pola kunci rahasia",
    "tests": "test runner terdeteksi dan exit 0",
    "build": "build script terdeteksi dan exit 0",
    "graph": "graphify-out/GRAPH_REPORT.md ada dan lebih baru dari kode",
    "design-audit": "inspect.mjs 0 FAIL pada rute x lebar yang dikonfigurasi",
